{
  "name": "@execlens/ide-vscode",
  "version": "0.1.0",
  "private": true,
  "displayName": "Execlens",
  "type": "module",
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "execlens.openSimulator",
        "title": "Execlens: Open Simulator"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "execlens.openSimulator",
          "when": "editorTextFocus && execlens.isFunctionUnderCursor",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "execlens.openSimulator",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@execlens/adapter-node-runtime": "workspace:*",
    "@execlens/adapter-tsjs": "workspace:*",
    "@execlens/core": "workspace:*",
    "@execlens/protocol": "workspace:*",
    "@execlens/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0"
  }
}
