{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Execlens Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/adapters/ide/vscode"],
      "outFiles": ["${workspaceFolder}/packages/adapters/ide/vscode/dist/**/*.js"],
      "preLaunchTask": "pnpm: build (ide-vscode)"
    }
  ]
}
