{
  "name": "execlens",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "IDE function execution simulator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decazed/ExecLens.git"
  },
  "bugs": {
    "url": "https://github.com/decazed/ExecLens/issues"
  },
  "homepage": "https://github.com/decazed/ExecLens#readme",
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm --filter @execlens/ui copy:assets",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -b tsconfig.json --pretty",
    "architecture:check": "node ./scripts/check-architecture.mjs",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:unit": "vitest run test/packages",
    "test:playground": "vitest run test/playground",
    "test:ui": "vitest run test/packages/ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quality": "pnpm architecture:check && pnpm typecheck && pnpm test:all && pnpm build",
    "dev:vscode": "pnpm --filter @execlens/ide-vscode watch"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7.0.0 <7.29.0": "^7.29.0",
      "postcss@<8.5.23": "^8.5.23"
    }
  }
}
